[Unit]
Description=QuantAgent Dashboard - Web监控仪表盘
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/d/AI/quant-agent
Environment=PYTHONPATH=/mnt/d/AI/quant-agent
ExecStart=/usr/bin/python3 -c "from web.app import start_dashboard; start_dashboard(port=5001)"
StandardOutput=append:/mnt/d/AI/quant-agent/logs/dashboard.log
StandardError=append:/mnt/d/AI/quant-agent/logs/dashboard.log
Restart=on-failure
RestartSec=5
