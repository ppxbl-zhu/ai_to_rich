[Unit]
Description=QuantAgent Monitor - 实时盘中监控
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/d/AI/quant-agent
Environment=PYTHONPATH=/mnt/d/AI/quant-agent
ExecStart=/usr/bin/python3 scripts/monitor_daemon.py
StandardOutput=append:/mnt/d/AI/quant-agent/logs/monitor.log
StandardError=append:/mnt/d/AI/quant-agent/logs/monitor.log
Restart=on-failure
RestartSec=10
