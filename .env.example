# The application refuses every execution mode except paper.
QUANTAGENT_EXECUTION_MODE=paper

# Local default is SQLite. PostgreSQL is available through docker-compose.
QUANTAGENT_DATABASE_URL=sqlite:///data/quantagent.db
# QUANTAGENT_DATABASE_URL=postgresql+psycopg://quantagent:change-me@localhost:5432/quantagent

# Paper runtime. Runtime files are ignored by Git.
QUANTAGENT_MARKET_DATA_MODE=offline
QUANTAGENT_PAPER_STATE=data/paper/runtime.json
QUANTAGENT_EASTMONEY_READ_ONLY=false

# Required only when QUANTAGENT_MARKET_DATA_MODE=tushare.
# Never commit the real token.
TUSHARE_TOKEN=
