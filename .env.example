# ============================================================
# QuantAgent 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- 部署模式 ---
DEPLOYMENT_MODE=local          # local | cloud | hybrid

# --- LLM 配置 (DeepSeek) ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat        # deepseek-chat | deepseek-reasoner
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.3            # 分析用低温度, 创造性探索用高温度

# --- 数据源 ---
TUSHARE_TOKEN=your-tushare-token

# --- 数据库 ---
# SQLite (本地, 始终可用)
SQLITE_PATH=data/quantagent.db

# TimescaleDB (云端, 可选)
TIMESCALE_HOST=47.99.88.123
TIMESCALE_PORT=5432
TIMESCALE_DB=quantagent
TIMESCALE_USER=quantagent
TIMESCALE_PASSWORD=

# Redis (事件总线跨进程, 可选)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- 通知 ---
# Telegram
TELEGRAM_BOT_TOKEN=

# Server酱微信 (多Key逗号分隔)
SCT_SEND_KEYS=

# 邮件
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_PASSWORD=

# --- GA 参数 ---
GA_POPULATION_SIZE_DAILY=20
GA_POPULATION_SIZE_WEEKLY=50
GA_POPULATION_SIZE_MONTHLY=100
GA_MAX_GENERATIONS_DAILY=5
GA_MAX_GENERATIONS_WEEKLY=20
GA_MAX_GENERATIONS_MONTHLY=50
GA_PARALLEL_WORKERS=4
GA_EARLY_STOP_GENERATIONS=10

# --- 模拟盘 ---
SIM_INITIAL_CAPITAL=100000      # 初始资金
SIM_MAX_POSITIONS=5             # 最大持仓数
SIM_MAX_POSITION_PCT=0.25       # 单票最大仓位
SIM_COMMISSION=0.0005           # 佣金
SIM_STAMP_TAX=0.001             # 印花税(仅卖出)
SIM_SLIPPAGE=0.001              # 滑点

# --- 日志 ---
LOG_LEVEL=INFO

# Telegram Chat ID (给 @userinfobot 发消息获取)
TELEGRAM_CHAT_ID=
