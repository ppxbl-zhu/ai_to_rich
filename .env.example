# The application refuses every execution mode except paper.
QUANTAGENT_EXECUTION_MODE=paper

# Local default is SQLite. PostgreSQL is available through docker-compose.
QUANTAGENT_DATABASE_URL=sqlite:///var/quantagent.db
# QUANTAGENT_DATABASE_URL=postgresql+psycopg://quantagent:change-me@localhost:5432/quantagent

# Optional in Milestone 0. Never commit the real token.
TUSHARE_TOKEN=
